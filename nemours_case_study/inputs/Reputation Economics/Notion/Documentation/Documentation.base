# Documentation

filters:
  and:
    - note["base"] == link("Documentation.base")
properties:
  file.name:
    displayName: Doc name
  Last updated time:
    displayName: Last updated time
  Created time:
    displayName: Created time
  Last edited by:
    displayName: Last edited by
  Category:
    displayName: Category
  Created by:
    displayName: Created by
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Last updated time
      - Created time
      - Last edited by
      - Category
      - Created by
