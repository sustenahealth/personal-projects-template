# === Required ===
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
NCBI_API_KEY=...                   # PubMed E-utilities — get free key at https://www.ncbi.nlm.nih.gov/account/
SEMANTIC_SCHOLAR_API_KEY=...       # Free key at https://www.semanticscholar.org/product/api

# === Service ===
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# === Paths ===
OUTPUT_DIR=output

# === Timeouts (seconds) ===
PERPLEXITY_TIMEOUT=30
EXTERNAL_API_TIMEOUT=15

# === Optional ===
# BENCHMARK_CASE=andrew_dauber     # Set to run a named benchmark fixture
# MODEL_NAME=claude-sonnet-4-6     # Defaults to claude-sonnet-4-6
